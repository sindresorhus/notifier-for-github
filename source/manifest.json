{
	"name": "Notifier for GitHub",
	"version": "0.0.0",
	"description": "Displays your GitHub notifications unread count",
	"homepage_url": "https://github.com/sindresorhus/notifier-for-github",
	"manifest_version": 3,
	"minimum_chrome_version": "88",
	"browser_specific_settings": {
		"gecko": {
			"id": "{8d1582b2-ff2a-42e0-ba40-42f4ebfe921b}",
			"strict_min_version": "106.0"
		}
	},
	"icons": {
		"128": "icon.png"
	},
	"permissions": [
		"alarms",
		"storage",
		"offscreen"
	],
	"optional_permissions": [
		"tabs",
		"notifications"
	],
	"host_permissions": [
		"https://api.github.com/*",
		"https://github.com/*"
	],
	"optional_host_permissions": [
		"https://*/*"
	],
	"background": {
		"service_worker": "background-multi.js",
		"type": "module"
	},
	"action": {
		"default_icon": "icon-toolbar.png",
		"default_popup": "popup.html"
	},
	"options_ui": {
		"page": "options-multi.html"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"icon-notif.png",
				"icon-toolbar.png",
				"sounds/bell.ogg"
			],
			"matches": []
		}
	]
}
